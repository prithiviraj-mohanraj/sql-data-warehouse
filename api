#!/bin/bash

IMPALA_HOST="your-host"

SQL_FILE="numeric_queries.sql"

OUTPUT_FILE="numeric_results.csv"

echo "schema,table,column,min,max,sum,avg,count" > $OUTPUT_FILE

impala-shell \
-k \
-i $IMPALA_HOST \
-B \
-f $SQL_FILE 2>/dev/null |
awk -F'\t' '
NF>=8{
print $1","$2","$3","$4","$5","$6","$7","$8
}
' >> $OUTPUT_FILE

echo "Completed"

nohup bash run_numeric_validation.sh > logs/numeric.log 2>&1 &
