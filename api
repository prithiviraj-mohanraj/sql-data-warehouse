01_extract_columns.sh
#!/bin/bash

INPUT="../input/tables.csv"
OUT="../output/table_columns.psv"

> $OUT

tail -n +2 $INPUT | while IFS=',' read SCHEMA TABLE
do

impala-shell -k -i your-host -B -q "
DESCRIBE ${SCHEMA}.${TABLE}
" 2>/dev/null |
awk -v s=$SCHEMA -v t=$TABLE '
NF>=2 && $1!="#" {
print s "|" t "|" $1 "|" $2
}' >> $OUT

echo "$SCHEMA.$TABLE extracted"

done

02_generate_validation_sql.py
import csv

INPUT_COLUMNS = "../output/table_columns.psv"
INPUT_PK = "../input/primary_keys.csv"

SQL_OUT = "../generated_sql/validation_queries.sql"

numeric_types = [
    'int','bigint','smallint',
    'double','float','decimal'
]

tables = {}

# -----------------------------------------
# Read columns
# -----------------------------------------
with open(INPUT_COLUMNS) as f:

    reader = csv.reader(f, delimiter='|')

    for row in reader:

        schema, table, col, dtype = row

        key = (schema, table)

        if key not in tables:
            tables[key] = {
                "numeric": [],
                "columns": []
            }

        tables[key]["columns"].append(col)

        dtype_lower = dtype.lower()

        if any(x in dtype_lower for x in numeric_types):
            tables[key]["numeric"].append(col)

# -----------------------------------------
# Read PKs
# -----------------------------------------
pk_map = {}

with open(INPUT_PK) as f:

    next(f)

    for line in f:

        schema, table, pk = line.strip().split(",")

        pk_map[(schema, table)] = pk

# -----------------------------------------
# Generate SQL
# -----------------------------------------
with open(SQL_OUT, "w") as out:

    for key, meta in tables.items():

        schema, table = key

        numeric_cols = meta["numeric"]

        pk = pk_map.get((schema, table))

        select_parts = []

        # total count
        select_parts.append(f"COUNT(*) AS total_count")

        # min max business date
        if "kafka_process_dt" in meta["columns"]:
            dt_col = "kafka_process_dt"
        else:
            dt_col = "ods_business_day"

        select_parts.append(f"MIN({dt_col}) AS min_date")
        select_parts.append(f"MAX({dt_col}) AS max_date")

        # numeric validations
        for c in numeric_cols:

            select_parts.append(f"SUM({c}) AS sum_{c}")
            select_parts.append(f"AVG({c}) AS avg_{c}")
            select_parts.append(f"MIN({c}) AS min_{c}")
            select_parts.append(f"MAX({c}) AS max_{c}")

        query = f"""
SELECT
'{schema}' AS schema_name,
'{table}' AS table_name,
{",".join(select_parts)}
FROM {schema}.{table};
"""

        out.write(query + "\n")

        # duplicate check
        if pk:

            dup_query = f"""
SELECT
'{schema}' AS schema_name,
'{table}' AS table_name,
COUNT(*) AS duplicate_count
FROM (
SELECT {pk}, COUNT(*)
FROM {schema}.{table}
GROUP BY {pk}
HAVING COUNT(*) > 1
)x;
"""

            out.write(dup_query + "\n")
