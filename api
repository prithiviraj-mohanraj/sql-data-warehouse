# =========================================================
# FILE NAME : generate_numeric_validation_sql.py
#
# PURPOSE:
# Generate SQL dynamically for ALL NUMERIC COLUMNS
# for latest partition date only.
#
# OUTPUT:
# sql/<schema>_<table>.sql
#
# INPUT FILE 1:
# latest_partition_tables.csv
#
# schema,table,date_column,latest_date
#
# INPUT FILE 2:
# columns.psv
#
# schema|table|column|datatype
#
# =========================================================

import csv
import os

# =========================================================
# INPUT FILES
# =========================================================

TABLE_FILE = "latest_partition_tables.csv"
COLUMN_FILE = "columns.psv"

# =========================================================
# OUTPUT SQL DIRECTORY
# =========================================================

SQL_DIR = "sql"

os.makedirs(SQL_DIR, exist_ok=True)

# =========================================================
# NUMERIC TYPES
# =========================================================

NUMERIC_TYPES = [
    "int",
    "bigint",
    "smallint",
    "tinyint",
    "double",
    "float",
    "decimal",
    "numeric"
]

# =========================================================
# READ TABLE + LATEST PARTITION INFO
# =========================================================

table_info = {}

with open(TABLE_FILE) as f:

    reader = csv.DictReader(f)

    for row in reader:

        schema = row["schema"].strip().lower()
        table = row["table"].strip().lower()

        table_info[(schema, table)] = {
            "date_column": row["date_column"].strip(),
            "latest_date": row["latest_date"].strip()
        }

# =========================================================
# GENERATE SQL PER TABLE
# =========================================================

table_queries = {}

with open(COLUMN_FILE) as f:

    for line in f:

        parts = line.strip().split("|")

        if len(parts) < 4:
            continue

        schema = parts[0].strip().lower()
        table = parts[1].strip().lower()
        column = parts[2].strip().lower()
        datatype = parts[3].strip().lower()

        # -------------------------------------------------
        # ONLY NUMERIC COLUMNS
        # -------------------------------------------------

        if not any(x in datatype for x in NUMERIC_TYPES):
            continue

        key = (schema, table)

        # -------------------------------------------------
        # TABLE MUST EXIST IN LATEST PARTITION FILE
        # -------------------------------------------------

        if key not in table_info:
            continue

        date_column = table_info[key]["date_column"]
        latest_date = table_info[key]["latest_date"]

        # -------------------------------------------------
        # SQL QUERY
        # -------------------------------------------------

        query = f"""
SELECT
'{schema}' AS schema_name,
'{table}' AS table_name,
'{column}' AS column_name,
MIN({column}) AS min_value,
MAX({column}) AS max_value,
SUM({column}) AS sum_value,
AVG({column}) AS avg_value,
COUNT({column}) AS count_value
FROM {schema}.{table}
WHERE {date_column} = '{latest_date}';
"""

        if key not in table_queries:
            table_queries[key] = []

        table_queries[key].append(query)

# =========================================================
# WRITE SQL FILES
# =========================================================

for key, queries in table_queries.items():

    schema, table = key

    sql_file = f"{SQL_DIR}/{schema}_{table}.sql"

    with open(sql_file, "w") as out:

        for q in queries:
            out.write(q + "\n")

print("====================================")
print("SQL FILES GENERATED")
print("====================================")
print("OUTPUT DIRECTORY :", SQL_DIR)
print("====================================")

# =========================================================
# FILE NAME : run_numeric_validation_parallel.py
#
# PURPOSE:
# Execute generated SQL files in parallel
# using 5 threads.
#
# OUTPUT:
# numeric_validation_output.csv
#
# =========================================================

import subprocess
import glob
from concurrent.futures import ThreadPoolExecutor, as_completed

# =========================================================
# CONFIG
# =========================================================

IMPALA_HOST = "your-host"

SQL_DIR = "sql"

OUTPUT_FILE = "numeric_validation_output.csv"

MAX_THREADS = 5

# =========================================================
# GET SQL FILES
# =========================================================

sql_files = glob.glob(f"{SQL_DIR}/*.sql")

# =========================================================
# RUN SQL FILE
# =========================================================

def run_sql_file(sql_file):

    cmd = [
        "impala-shell",
        "-k",
        "-i", IMPALA_HOST,
        "-B",
        "-f", sql_file
    ]

    try:

        result = subprocess.check_output(
            cmd,
            stderr=subprocess.DEVNULL
        )

        lines = result.decode().strip().split("\n")

        output_rows = []

        for line in lines:

            cols = line.split("\t")

            if len(cols) >= 8:

                output_rows.append(",".join(cols[:8]))

        print(f"{sql_file} completed")

        return output_rows

    except Exception as e:

        print(f"{sql_file} failed")

        return []

# =========================================================
# EXECUTE IN PARALLEL
# =========================================================

all_results = []

with ThreadPoolExecutor(max_workers=MAX_THREADS) as executor:

    futures = {
        executor.submit(run_sql_file, sql_file): sql_file
        for sql_file in sql_files
    }

    for future in as_completed(futures):

        rows = future.result()

        all_results.extend(rows)

# =========================================================
# WRITE FINAL OUTPUT
# =========================================================

with open(OUTPUT_FILE, "w") as out:

    out.write(
        "schema_name,table_name,column_name,min_value,max_value,sum_value,avg_value,count_value\n"
    )

    for row in all_results:
        out.write(row + "\n")

print("====================================")
print("VALIDATION COMPLETED")
print("====================================")
print("OUTPUT FILE :", OUTPUT_FILE)
print("====================================")

python generate_numeric_validation_sql.py
nohup python run_numeric_validation_parallel.py \
> numeric_validation.log 2>&1 &
