generate_numeric_queries.py
import csv

TABLE_FILE="latest_partition.csv"
COLUMN_FILE="columns.psv"

OUT_SQL="numeric_queries.sql"

numeric_types=[
'int',
'bigint',
'smallint',
'tinyint',
'double',
'float',
'decimal',
'numeric'
]

table_map={}

# latest partition info
with open(TABLE_FILE) as f:

    reader=csv.DictReader(f)

    for row in reader:

        key=(row['schema'],row['table'])

        table_map[key]={
            'date_column':row['date_column'],
            'max_date':row['max_date']
        }

out=open(OUT_SQL,'w')

# generate SQL
with open(COLUMN_FILE) as f:

    for line in f:

        parts=line.strip().split("|")

        if len(parts)<4:
            continue

        schema,table,column,datatype=parts[:4]

        datatype=datatype.lower()

        if not any(x in datatype for x in numeric_types):
            continue

        key=(schema,table)

        if key not in table_map:
            continue

        date_col=table_map[key]['date_column']
        max_date=table_map[key]['max_date']

        sql=f"""
SELECT
'{schema}',
'{table}',
'{column}',
MIN({column}),
MAX({column}),
SUM({column}),
AVG({column}),
COUNT({column})
FROM {schema}.{table}
WHERE {date_col}='{max_date}';
"""

        out.write(sql+"\n")

out.close()

print("SQL generated")


