#!/bin/bash

SCHEMA=$1
TABLE=$2
PART_COL=$3

IMPALA_HOST="your-host"

OUT_FILE="${SCHEMA}_${TABLE}_partition_counts.csv"

echo "partition_date,count" > $OUT_FILE

QUERY="
SELECT ${PART_COL}, COUNT(*)
FROM ${SCHEMA}.${TABLE}
WHERE ${PART_COL} IS NOT NULL
GROUP BY ${PART_COL}
ORDER BY ${PART_COL};
"

impala-shell -k -i $IMPALA_HOST -B -q "$QUERY" 2>/dev/null |
awk -F'\t' '
NF>=2 {
print $1","$2
}' >> $OUT_FILE

echo "Completed -> $OUT_FILE"


