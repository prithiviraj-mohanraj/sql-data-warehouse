import pandas as pd
from concurrent.futures import ThreadPoolExecutor, as_completed

# -----------------------------
# INPUT FILES
# -----------------------------
TABLE_FILE="latest_partition.csv"
COLUMN_FILE="columns.psv"

MAX_THREADS=5

# -----------------------------
# LOAD TABLE INFO
# -----------------------------
table_df=pd.read_csv(TABLE_FILE)

table_map={}

for _,row in table_df.iterrows():

    key=(row['schema'].lower(),
         row['table'].lower())

    table_map[key]={
        'date_column':row['date_column'],
        'max_date':str(row['max_date'])
    }

# -----------------------------
# NUMERIC TYPES
# -----------------------------
numeric_types=[
    'int',
    'bigint',
    'smallint',
    'tinyint',
    'number',
    'decimal',
    'numeric',
    'float',
    'double'
]

queries=[]

# -----------------------------
# BUILD QUERIES
# -----------------------------
with open(COLUMN_FILE) as f:

    for line in f:

        parts=line.strip().split("|")

        if len(parts)<4:
            continue

        schema,table,column,datatype=parts[:4]

        schema=schema.lower()
        table=table.lower()

        datatype=datatype.lower()

        if not any(x in datatype for x in numeric_types):
            continue

        key=(schema,table)

        if key not in table_map:
            continue

        date_col=table_map[key]['date_column']
        max_date=table_map[key]['max_date']

        query=f"""
SELECT
'{schema}' AS schema_name,
'{table}' AS table_name,
'{column}' AS column_name,
MIN({column}) AS min_value,
MAX({column}) AS max_value,
SUM({column}) AS sum_value,
AVG({column}) AS avg_value,
COUNT({column}) AS count_value
FROM prod.{schema}.{table}
WHERE {date_col}='{max_date}'
"""

        queries.append(query)

print("Queries generated:",len(queries))

results=[]

def run_query(query):

    try:

        df=session.sql(query).to_pandas()

        if len(df)>0:
            return df.iloc[0].to_dict()

    except Exception:

        return None


with ThreadPoolExecutor(max_workers=MAX_THREADS) as executor:

    futures=[
        executor.submit(run_query,q)
        for q in queries
    ]

    completed=0

    for future in as_completed(futures):

        result=future.result()

        if result:
            results.append(result)

        completed+=1

        if completed%100==0:
            print(f"{completed} queries completed")

sf_numeric_results=pd.DataFrame(results)

sf_numeric_results.to_csv(
    "snowflake_numeric_results.csv",
    index=False
)

